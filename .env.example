# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored and may contain secrets — never commit it.

# --- Server ---
PORT=8788
HOST=0.0.0.0

# --- MariaDB ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=podany
DB_USER=podany
DB_PASSWORD=change-me
DB_POOL_MAX=10

# --- App ---
APP_URL=http://localhost:8788
FROM_EMAIL="Podany <login@podany.poizoom.com>"

# --- Auth ---
# Required: used to sign the session cookie. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-string
# magic | local | mixed
AUTH_MODE=magic
# Set to false to disable magic-link login entirely (send-link returns 403).
MAGIC_LINK_ENABLED=true
# Set to false for plain HTTP (localhost) so the session cookie is not marked Secure.
COOKIE_SECURE=true

# --- Email (optional) ---
# Without a key, send-link returns the verify URL directly (local dev mode).
RESEND_API_KEY=

# --- Rate limiting ---
# Login links allowed per email per hour.
RATE_LIMIT_LINKS_PER_HOUR=60

# --- CORS ---
# Allowed origin, or * for all.
CORS_ORIGIN=*

# --- WebSocket (live events on /live) ---
# Endpoint for the WebSocket upgrade (same port as HTTP).
WEBSOCKET_PATH=/live
# Server ping interval in ms.
WS_HEARTBEAT_INTERVAL_MS=30000
# Timeout until a connection is dropped when pong is missing, in ms.
WS_HEARTBEAT_TIMEOUT_MS=60000

# --- Deployment: Port 80 & Reverse Proxy ---
# The WebSocket upgrade runs on the SAME port as HTTP (no separate WS port).
# For a direct bind on port 80 set PORT=80 and map 80:80; the container then needs
# CAP_NET_BIND_SERVICE (see docker-compose.yml) to bind the low-level port.
# Plain HTTP ⇒ set COOKIE_SECURE=false so the session cookie is sent.
# Behind a TLS-terminating reverse proxy (nginx/Caddy), forward the upgrade headers
# so /live works over wss://:
#   proxy_set_header Upgrade $http_upgrade;
#   proxy_set_header Connection "upgrade";
#   proxy_http_version 1.1;
#   proxy_set_header Host $host;
#   proxy_set_header X-Forwarded-For $proxy_x_forwarded_for;
#   proxy_read_timeout 3600s;   # WebSocket keeps the connection open

# --- Default user (optional) ---
# When set, a default user is created on startup (idempotent).
# This user can log in with their password (AUTH_MODE=local or mixed).
# Leave DEFAULT_USER_EMAIL empty to disable.
DEFAULT_USER_EMAIL=admin@podany.local
DEFAULT_USER_PASSWORD=change-me
DEFAULT_USER_COLOR=#d8cdbe
