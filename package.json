{
  "name": "podany",
  "version": "1.0.0",
  "description": "Private podcast RSS feed aggregator and web player (self-hosted Express + MariaDB)",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "db:migrate": "node server/db/migrator.js",
    "build": "esbuild public/js/main.js --bundle --minify --outfile=public/dist/bundle.js --format=esm",
    "migrate:data": "node server/db/migrate-data.js",
    "test": "node --test"
  },
  "keywords": [
    "podcast",
    "rss",
    "web-player",
    "self-hosted",
    "express"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "mysql2": "^3.11.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "esbuild": "^0.23.0"
  }
}
